PORT=3000
JWT_SECRET=change-me-at-least-32-chars

# MongoDB（可选；不填则使用内存存储模式）
MONGODB_URI=

# Redis（可选；不填则不启用队列与缓存）
REDIS_URL=
ENABLE_REDIS=0

# 火山引擎（可选；不填则 AI 输出使用可测试的降级逻辑）
VOLCANO_API_URL=https://ark.cn-beijing.volces.com/api/v3/responses
VOLCANO_API_KEY=
VOLCANO_MODEL_ID=

# OpenAI Compatible（可选；例如阿里云 DashScope compatible-mode）
# AI_PROVIDER=openai_compatible
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=

# 微信小程序（可选；不填则只能使用 /auth/dev-login）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 强制使用内存模式（1=是）
USE_IN_MEMORY_STORE=1
